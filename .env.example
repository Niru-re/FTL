# ──────────────────────────────────────────────────────────────────────────────
# CareBridge Hospital Management System — Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
#
# Copy this file to .env and fill in the values.
# NEVER commit your actual .env file to version control.
#
# ── FRONTEND (Vercel) ─────────────────────────────────────────────────────────
#
# Set this in Vercel Project → Settings → Environment Variables
#
# The URL of your deployed FastAPI backend (no trailing slash).
# Examples:
#   https://carebridge-api.railway.app
#   https://carebridge-api.onrender.com
#   https://carebridge.fly.dev
#
VITE_API_BASE_URL=https://your-backend-url.railway.app

# ── BACKEND (FastAPI — Railway / Render / Fly.io) ─────────────────────────────
#
# Comma-separated list of allowed frontend origins for CORS.
# Add your Vercel deployment URL here (no trailing slash).
# Example:
#   ALLOWED_ORIGINS=https://carebridge.vercel.app,https://carebridge-git-main.vercel.app
#
ALLOWED_ORIGINS=https://your-app.vercel.app

# JWT secret key — change this to a long random string in production.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-secret-in-production

# ── LOCAL DEV ONLY ────────────────────────────────────────────────────────────
# These are the defaults used when env vars above are not set.
# Backend runs on:   http://127.0.0.1:8000
# Frontend runs on:  http://127.0.0.1:5173
